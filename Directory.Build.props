<Project>
    <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')"/>

    <PropertyGroup>
        <SignAssembly Condition="Exists('JALib.snk')">true</SignAssembly>
        <AssemblyOriginatorKeyFile Condition="Exists('JALib.snk')">..\JALib.snk</AssemblyOriginatorKeyFile>

        <GameManagedPath Condition="'$(GameManagedPath)' == ''">C:/Program Files (x86)/Steam/steamapps/common/A Dance of Fire and Ice/A Dance of Fire and Ice_Data/Managed</GameManagedPath>
    </PropertyGroup>
</Project>